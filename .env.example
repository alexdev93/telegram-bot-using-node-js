# Copy to .env and fill in. Never commit real values.

# Bot token from @BotFather. API_KEY is still read as a fallback for older deployments
TELEGRAM_BOT_TOKEN=8978245878:AAH6hRh73bwlF3etCVjcoutgIqGHT8quql8
# Public host for the Telegram webhook, e.g. my-bot.example.com. Empty = long polling
WEBHOOK_DOMAIN=telegram-bot.alexdev93.deno.net
PORT=8000

# --- Internal OTP API (docs/contracts/telegram-otp.v1.md) ---
# The API stays disabled (503 not_configured) until the token, DATABASE_URL and a client are set.
# Credentials the auth service signs requests with. Secret: at least 32 random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BOT_SERVICE_CLIENT_ID=8978245878
BOT_SERVICE_CLIENT_SECRET=Nti1rKV7Uka7NAXvv-xWXp_mT2eC-MB2npPFlgmiEyem1g9RDBXosQ
# Set only while rotating; requests signed with either secret are accepted
BOT_SERVICE_CLIENT_SECRET_PREVIOUS=

# Bot-owned role with SELECT/INSERT/UPDATE on its own tables only
# e.g. postgres://bot_service:<password>@db.example.com:5432/bot?sslmode=verify-full
DATABASE_URL=postgresql://neondb_owner:npg_nhei4DkVBz5b@ep-noisy-tree-ay5hjyps-pooler.c-5.us-east-2.aws.neon.tech/mamechyet?sslmode=require&channel_binding=require
# Schema owner role, used only by `npm run migrate`. Defaults to DATABASE_URL
DATABASE_MIGRATION_URL=

# Per Telegram API call
TELEGRAM_API_TIMEOUT_MS=5000
# Telegram send attempts per challenge (transient errors only)
NOTIFICATION_MAX_ATTEMPTS=3
# Requests per minute per client
NOTIFICATION_RATE_LIMIT=60
# New codes per Telegram recipient per 10 minutes
OTP_RECIPIENT_RATE_LIMIT=5
# Furthest ahead expiresAt may be
OTP_MAX_TTL_SECONDS=900
