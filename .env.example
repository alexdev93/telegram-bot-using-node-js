# Copy to .env and fill in. Never commit real values: this file is public.

# Bot token from @BotFather. API_KEY is still read as a fallback for older deployments
TELEGRAM_BOT_TOKEN=
# Public host for the Telegram webhook, e.g. my-bot.example.com. Empty = long polling
WEBHOOK_DOMAIN=
# Telegram sends this in the X-Telegram-Bot-Api-Secret-Token header of every webhook call, and
# updates without it are rejected. 1-256 of A-Z a-z 0-9 _ -, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
WEBHOOK_SECRET_TOKEN=
PORT=8000

# --- Internal OTP API (docs/contracts/telegram-otp.v1.md) ---
# The API stays disabled (503 not_configured) until the token, DATABASE_URL and a client are set.
# Credentials the auth service signs requests with. Secret: at least 32 random characters, its
# own value (never reuse another credential such as the Telegram login client secret)
BOT_SERVICE_CLIENT_ID=
BOT_SERVICE_CLIENT_SECRET=
# Set only while rotating; requests signed with either secret are accepted
BOT_SERVICE_CLIENT_SECRET_PREVIOUS=

# Bot-owned role with SELECT/INSERT/UPDATE on its own tables only
# e.g. postgres://bot_service:<password>@db.example.com:5432/bot?sslmode=verify-full
DATABASE_URL=
# Schema owner role, used only by `npm run migrate`. Defaults to DATABASE_URL
DATABASE_MIGRATION_URL=

# Per Telegram API call
TELEGRAM_API_TIMEOUT_MS=5000
# Telegram send attempts per challenge (transient errors only)
NOTIFICATION_MAX_ATTEMPTS=3
# Requests per minute per client
NOTIFICATION_RATE_LIMIT=60
# New codes per Telegram recipient per 10 minutes
OTP_RECIPIENT_RATE_LIMIT=5
# Furthest ahead expiresAt may be
OTP_MAX_TTL_SECONDS=900

# --- Bot-access events to the auth service (docs/contracts/telegram-otp.v1.md, section 9) ---
# Reports when a user allows, blocks or unblocks the bot. Disabled until URL and secret are set.
# Auth service base URL, e.g. https://ma-mech-yet.vercel.app
AUTH_SERVICE_URL=
# Client id and secret the bot signs events with; the auth service must have the same values.
# Secret: at least 32 random characters, different from every other secret here
BOT_EVENTS_CLIENT_ID=telegram-bot
BOT_EVENTS_SECRET=
# Websites whose Telegram Login grants count, comma-separated. Defaults to AUTH_SERVICE_URL's host
LOGIN_DOMAINS=
